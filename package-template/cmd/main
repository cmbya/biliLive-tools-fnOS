#!/bin/bash
set -u

RUNTIME="${TRIM_PKGVAR}/native-runtime"
FRONT_PID="${TRIM_PKGVAR}/bililivetools.front.pid"
BACK_PID="${TRIM_PKGVAR}/bililivetools.back.pid"

FRONT_PORT="${TRIM_SERVICE_PORT:-3000}"
BACK_PORT="18010"
VIDEO_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

LOG_DIR="${VIDEO_DIR}/biliLive-tools-Logs"
FRONT_LOG="${LOG_DIR}/webui.log"
BACK_LOG="${LOG_DIR}/backend.log"
MAIN_LOG="${LOG_DIR}/main.log"

export PATH="/var/apps/python312/target/bin:$RUNTIME/bin:/var/apps/nodejs_v22/target/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export NODE_ENV=production
export TZ=Asia/Shanghai
export HOME="$RUNTIME/home"
export BAIDUPCS_GO_CONFIG_DIR="$RUNTIME/data"
export ALIYUNPAN_CONFIG_DIR="$RUNTIME/data"
export BILILIVE_TOOLS_DELETE_DIRS="$VIDEO_DIR"

pid_alive() {
  local f="$1" p=""
  [ -f "$f" ] || return 1
  p="$(head -n1 "$f" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

clean_pid() {
  pid_alive "$1" || rm -f "$1"
}

is_running() {
  clean_pid "$BACK_PID"
  clean_pid "$FRONT_PID"
  pid_alive "$BACK_PID" && pid_alive "$FRONT_PID"
}

rotate_log() {
  local f="$1"
  [ -f "$f" ] || return 0

  local size
  size="$(wc -c < "$f" 2>/dev/null || echo 0)"

  if [ "${size:-0}" -ge 10485760 ]; then
    rm -f "${f}.1"
    mv "$f" "${f}.1"
  fi
}

prepare_logs() {
  mkdir -p "$LOG_DIR" || return 1

  rotate_log "$BACK_LOG"
  rotate_log "$FRONT_LOG"
  rotate_log "$MAIN_LOG"

  return 0
}

repair_video_link() {
  [ -n "$VIDEO_DIR" ] || return 1
  mkdir -p "$VIDEO_DIR" "$RUNTIME" || return 1

  if [ -L "$RUNTIME/video" ]; then
    local cur
    cur="$(readlink "$RUNTIME/video" 2>/dev/null || true)"

    if [ "$cur" != "$VIDEO_DIR" ]; then
      rm -f "$RUNTIME/video"
      ln -s "$VIDEO_DIR" "$RUNTIME/video"
    fi
  elif [ ! -e "$RUNTIME/video" ]; then
    ln -s "$VIDEO_DIR" "$RUNTIME/video"
  fi
}

configure_visible_log() {
  python3 - "$RUNTIME/config.json" "$MAIN_LOG" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
log_path = sys.argv[2]

cfg = json.loads(
    path.read_text(encoding="utf-8")
)

cfg["logPath"] = log_path

path.write_text(
    json.dumps(
        cfg,
        ensure_ascii=False,
        indent=2,
    ) + "\n",
    encoding="utf-8",
)

print(
    "[fnOS native2 log] "
    f"application logPath={log_path}",
    flush=True,
)
PY
}

apply_time_patch() {
  python3 - "$RUNTIME/backend" <<'PY'
from __future__ import annotations

from pathlib import Path
import re
import sys

backend = Path(sys.argv[1]).resolve()
cli_root = backend / "node_modules" / "bililive-cli" / "lib"

if not cli_root.is_dir():
    raise SystemExit(
        "[fnOS native2 time] ERROR: "
        f"找不到 bililive-cli/lib: {cli_root}"
    )

START_MARKER = "// fnOS native2: monitor-time guard"
BATCH_MARKER = "// fnOS native2: Bilibili batch monitor-time guard"

start_pattern = re.compile(
    r"if\s*\(\s*!ignoreDataLimit\s*&&\s*"
    r"isBetweenTimeRange\(\s*recorder\.handleTime\s*\)"
    r"\s*\)\s*return\s*;?"
)

batch_pattern = re.compile(
    r'(\.filter\(\s*\(r\)\s*=>\s*'
    r'r\.providerId\s*===\s*["\']Bilibili["\']\s*\))'
)

candidates = []
for path in sorted(cli_root.rglob("*.cjs")):
    content = path.read_text(encoding="utf-8", errors="ignore")
    score = sum(
        item in content
        for item in (
            "ignoreDataLimit",
            "isBetweenTimeRange",
            "handleBatchQuery",
            'providerId === "Bilibili"',
        )
    )
    if score >= 2:
        candidates.append((score, path, content))

if not candidates:
    print(
        "[fnOS native2 time] ERROR: "
        "bililive-cli/lib 中没有找到包含录制管理器逻辑的 CJS bundle",
        flush=True,
    )
    print("[fnOS native2 time] lib files:", flush=True)
    for path in sorted(cli_root.rglob("*.cjs")):
        print("  " + str(path.relative_to(cli_root)), flush=True)
    raise SystemExit(1)

candidates.sort(key=lambda item: (-item[0], len(str(item[1]))))

target_path = None
target_text = None

for score, path, content in candidates:
    has_start = START_MARKER in content or start_pattern.search(content) is not None
    handle_pos = content.find("const handleBatchQuery")
    need_pos = content.find(
        "const needCheckRecorders",
        handle_pos if handle_pos >= 0 else 0,
    )
    has_batch = (
        BATCH_MARKER in content
        or (
            handle_pos >= 0
            and need_pos > handle_pos
            and batch_pattern.search(content[handle_pos:need_pos]) is not None
        )
    )
    if has_start and has_batch:
        target_path = path
        target_text = content
        break

if target_path is None or target_text is None:
    print(
        "[fnOS native2 time] ERROR: "
        "找到了 CJS bundle，但没有一个同时包含 startRecord 与 Bilibili batch 两个补丁点",
        flush=True,
    )
    for score, path, _ in candidates:
        print(f"  score={score}: {path.relative_to(cli_root)}", flush=True)
    raise SystemExit(1)

text = target_text
changed = False

print(
    "[fnOS native2 time] target bundle: "
    + str(target_path.relative_to(cli_root)),
    flush=True,
)

if START_MARKER not in text:
    matches = list(start_pattern.finditer(text))
    if len(matches) != 1:
        raise SystemExit(
            "[fnOS native2 time] ERROR: "
            f"startRecord 时间判断结构变化，期望 1 处，实际 {len(matches)} 处"
        )

    replacement = r'''// fnOS native2: monitor-time guard
      const fnosTimeAllowed = isBetweenTimeRange(recorder.handleTime);
      const fnosNow = new Date().toLocaleString(
        "zh-CN",
        {
          timeZone: "Asia/Shanghai",
          hour12: false,
        },
      );
      console.log(
        `[fnOS native2 time] startRecord ` +
        `id=${id} now=${fnosNow} ` +
        `handleTime=${JSON.stringify(recorder.handleTime)} ` +
        `ignoreDataLimit=${ignoreDataLimit} ` +
        `allowed=${fnosTimeAllowed}`,
      );
      if (!ignoreDataLimit && !fnosTimeAllowed) {
        console.log(
          `[fnOS native2 time] BLOCK startRecord outside monitor window id=${id}`,
        );
        return;
      }'''

    text = start_pattern.sub(replacement, text, count=1)
    changed = True

if BATCH_MARKER not in text:
    handle_pos = text.find("const handleBatchQuery")
    need_pos = text.find("const needCheckRecorders", handle_pos)
    if handle_pos < 0 or need_pos <= handle_pos:
        raise SystemExit(
            "[fnOS native2 time] ERROR: "
            "找不到 handleBatchQuery / needCheckRecorders"
        )

    head = text[handle_pos:need_pos]
    matches = list(batch_pattern.finditer(head))
    if len(matches) != 1:
        raise SystemExit(
            "[fnOS native2 time] ERROR: "
            f"Bilibili batch 结构变化，期望 1 处，实际 {len(matches)} 处"
        )

    replacement = r'''\1
        // fnOS native2: Bilibili batch monitor-time guard
        .filter((r) => {
          const allowed = isBetweenTimeRange(r.handleTime);
          if (
            !allowed &&
            Array.isArray(r.handleTime) &&
            r.handleTime.length === 2
          ) {
            const now = new Date().toLocaleString(
              "zh-CN",
              {
                timeZone: "Asia/Shanghai",
                hour12: false,
              },
            );
            console.log(
              `[fnOS native2 time] SKIP Bilibili batch ` +
              `channel=${r.channelId} now=${now} ` +
              `handleTime=${JSON.stringify(r.handleTime)}`,
            );
          }
          return allowed;
        })'''

    patched_head = batch_pattern.sub(replacement, head, count=1)
    text = text[:handle_pos] + patched_head + text[need_pos:]
    changed = True

if START_MARKER not in text:
    raise SystemExit("[fnOS native2 time] ERROR: startRecord guard 未生效")
if BATCH_MARKER not in text:
    raise SystemExit("[fnOS native2 time] ERROR: Bilibili batch guard 未生效")
if start_pattern.search(text):
    raise SystemExit("[fnOS native2 time] ERROR: 旧 startRecord 反向判断仍然存在")

if changed:
    target_path.write_text(text, encoding="utf-8")
    print("[fnOS native2 time] patched bundle: " + str(target_path), flush=True)
else:
    print("[fnOS native2 time] patch already present", flush=True)

print(
    "[fnOS native2 time] startRecord guard = OK; Bilibili batch guard = OK",
    flush=True,
)
PY
}

runtime_diagnostics() {
  {
    echo "============================================================"
    echo "$(date '+%F %T') [fnOS native2] runtime diagnostics"
    echo "TZ=${TZ:-}"
    echo "date=$(date '+%F %T %z %Z' 2>/dev/null || date)"
    echo "node=$(node -v 2>/dev/null || echo missing)"
    echo "python=$(python3 --version 2>/dev/null || echo missing)"
    echo "runtime_version=$(cat "$RUNTIME/VERSION" 2>/dev/null || echo unknown)"
    echo "visible_log_dir=$LOG_DIR"
    echo "============================================================"
  } >> "$BACK_LOG" 2>&1
}

stop_one() {
  local f="$1" p="" n=0

  if pid_alive "$f"; then
    p="$(head -n1 "$f" | tr -d '[:space:]')"

    kill -TERM -- "-$p" 2>/dev/null \
      || kill -TERM "$p" 2>/dev/null \
      || true

    while kill -0 "$p" 2>/dev/null && [ "$n" -lt 15 ]; do
      sleep 1
      n=$((n + 1))
    done

    if kill -0 "$p" 2>/dev/null; then
      kill -KILL -- "-$p" 2>/dev/null \
        || kill -KILL "$p" 2>/dev/null \
        || true
    fi
  fi

  rm -f "$f"
}

start_app() {
  if is_running; then
    return 0
  fi

  stop_one "$FRONT_PID"
  stop_one "$BACK_PID"

  repair_video_link || {
    echo "默认录像共享目录不可用。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  prepare_logs || {
    echo "无法创建 biliLive-tools-Logs 日志目录。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -x /var/apps/nodejs_v22/target/bin/node ] || {
    echo "飞牛 Node.js 22 运行时不可用。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -f "$RUNTIME/backend/ENTRY" ] || {
    echo "biliLive-tools 后端运行环境缺失，请重新安装/升级。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -f "$RUNTIME/webui/index.html" ] || {
    echo "biliLive-tools WebUI 缺失，请重新安装/升级。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -s "${TRIM_PKGETC}/passkey" ] || {
    echo "Web 管理密码不存在，请进入应用设置重新设置。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  echo "$(date '+%F %T') applying fnOS native2 monitor-time patch" >> "$BACK_LOG"

  if ! apply_time_patch >> "$BACK_LOG" 2>&1; then
    echo "biliLive-tools native2 时间段补丁失败，请在录像目录/biliLive-tools-Logs/backend.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  if ! configure_visible_log >> "$BACK_LOG" 2>&1; then
    echo "biliLive-tools 可见日志配置失败，请查看 backend.log。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  runtime_diagnostics

  export BILILIVE_TOOLS_PASSKEY="$(cat "${TRIM_PKGETC}/passkey")"
  export BILILIVE_TOOLS_BILIKEY="$(cat "$RUNTIME/bilikey")"

  ENTRY="$(
    cat "$RUNTIME/backend/ENTRY" 2>/dev/null \
      | head -n1 \
      | tr -d '\r\n'
  )"

  case "$ENTRY" in
    /*) ;;
    *) ENTRY="$RUNTIME/backend/$ENTRY" ;;
  esac

  if [ ! -f "$ENTRY" ]; then
    ENTRY="$(
      find "$RUNTIME/backend/node_modules/bililive-cli" \
        -type f \
        -name index.cjs \
        -path '*/lib/*' \
        | head -n1 \
        || true
    )"
  fi

  [ -n "$ENTRY" ] && [ -f "$ENTRY" ] || {
    echo "找不到 bililive-cli 启动文件。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  mkdir -p "$RUNTIME/data" "$RUNTIME/home"
  cd "$RUNTIME" || return 1

  printf '%s starting backend\n' "$(date '+%F %T')" >> "$BACK_LOG"

  if command -v setsid >/dev/null 2>&1; then
    setsid node "$ENTRY" server \
      --config "$RUNTIME/config.json" \
      >> "$BACK_LOG" 2>&1 &
  else
    node "$ENTRY" server \
      --config "$RUNTIME/config.json" \
      >> "$BACK_LOG" 2>&1 &
  fi

  echo $! > "$BACK_PID"

  sleep 3

  if ! pid_alive "$BACK_PID"; then
    rm -f "$BACK_PID"
    echo "biliLive-tools 后端启动失败，请在录像目录/biliLive-tools-Logs/backend.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  export FRONTEND_PORT="$FRONT_PORT"
  export BACKEND_PORT="$BACK_PORT"
  export BACKEND_HOST=127.0.0.1
  export WEB_ROOT="$RUNTIME/webui"

  printf '%s starting web wrapper\n' "$(date '+%F %T')" >> "$FRONT_LOG"

  if command -v setsid >/dev/null 2>&1; then
    setsid node "$RUNTIME/web_server.js" \
      >> "$FRONT_LOG" 2>&1 &
  else
    node "$RUNTIME/web_server.js" \
      >> "$FRONT_LOG" 2>&1 &
  fi

  echo $! > "$FRONT_PID"

  sleep 2

  if ! pid_alive "$FRONT_PID"; then
    stop_one "$BACK_PID"
    echo "biliLive-tools WebUI 启动失败，请在录像目录/biliLive-tools-Logs/webui.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  return 0
}

stop_app() {
  stop_one "$FRONT_PID"
  stop_one "$BACK_PID"
  return 0
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) if is_running; then exit 0; else exit 3; fi ;;
  *) echo "Unknown command: ${1:-}" > "${TRIM_TEMP_LOGFILE}"; exit 1 ;;
esac
